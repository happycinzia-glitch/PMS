# ═══════════════════════════════════════════════════════════
#  設定檔範本
#
#  用法：把這個檔案「複製」一份，改名成 .env，再把值填在等號後面。
#        （.env 已被 .gitignore 擋住，不會上傳到 GitHub）
#
#  完全不填也可以正常使用：系統會自動改用本機資料夾存放資料，
#  適合還沒進行到第 5、6 章的時候。
# ═══════════════════════════════════════════════════════════

# ── 第 5 章：免費資料庫（Neon）──────────────────────────
# 從 Neon 專案頁複製「Pooled connection」的連線字串，整串貼進來。
# 結尾的 ?sslmode=require 不能漏掉。
# 填好後重新啟動系統，再執行 node tools/import-db.js 把 data/db.json 的資料搬進資料庫。
# 本機版與線上版 (Render) 可以填同一串，兩邊的資料會互相看得到。
DATABASE_URL=

# ── 第 6 章：Google 雲端硬碟（存放專案結案附件）──────────
# 從 Google Cloud Console 的「憑證」頁取得
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 用 get-token.js 取得
GOOGLE_REFRESH_TOKEN=
# 雲端硬碟資料夾網址最後那一串英數字
GOOGLE_FOLDER_ID=

# ── 自動備份（左側「備份設定」頁）────────────────────────
# 備份到 Google 雲端硬碟時沿用上面第 6 章的四個值，不用另外設定。
# 下面這個只在「想用 cron-job.org 之類的外部服務定時觸發備份」時才需要：
# 填 30 字以上的亂數英數字，觸發網址為 https://你的網址/api/backup/trigger?key=這個值
# BACKUP_KEY=

# ── 選用設定（不填則使用預設值）────────────────────────
# 服務埠號，預設 3000
# PORT=3000

# 第一次啟動時建立的管理者密碼，預設 Admin0000（帳號 Admin）
# 只在「資料庫完全沒有帳號」時有作用
# ADMIN_PASSWORD=
